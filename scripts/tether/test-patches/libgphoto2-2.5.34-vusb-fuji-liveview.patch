+
+/**************************  Fujifilm USB tether live view ********************************/
+/* A Fujifilm body in USB tether mode serves live view as object 0x80000001
+ * once InitiateOpenCapture opened it: GetObjectInfo answers InvalidObjectHandle
+ * until the next frame is ready, GetObject hands it over, DeleteObject frees it.
+ * VCAMERA_FUJI_FRAME_MS sets the camera's frame interval (default 33 ms). */
+static int
+fuji_frame_ms(void) {
+	const char *ms = getenv("VCAMERA_FUJI_FRAME_MS");
+	return ms ? atoi(ms) : 33;
+}
+
+static void
+fuji_next_frame(vcamera *cam) {
+	struct timeval now;
+	int ms = fuji_frame_ms();
+
+	gettimeofday (&now, NULL);
+	now.tv_usec += (ms % 1000) * 1000;
+	now.tv_sec += ms / 1000 + now.tv_usec / 1000000;
+	now.tv_usec %= 1000000;
+	cam->fuji_frame_ready = now;
+}
+
+static int
+fuji_frame_is_ready(vcamera *cam) {
+	struct timeval now;
+
+	gettimeofday (&now, NULL);
+	return cam->fuji_liveview &&
+		((now.tv_sec > cam->fuji_frame_ready.tv_sec) ||
+		 ((now.tv_sec == cam->fuji_frame_ready.tv_sec) && (now.tv_usec >= cam->fuji_frame_ready.tv_usec)));
+}
+
+static int
+ptp_fuji_initiateopencapture_write(vcamera *cam, ptpcontainer *ptp) {
+	CHECK_SEQUENCE_NUMBER();
+	CHECK_SESSION();
+	if (cam->fuji_liveview) {
+		ptp_response(cam,0x2019,0);	/* DeviceBusy */
+		return 1;
+	}
+	cam->fuji_liveview = 1;
+	fuji_next_frame(cam);
+	ptp_response(cam,PTP_RC_OK,0);
+	return 1;
+}
+
+static int
+ptp_fuji_terminateopencapture_write(vcamera *cam, ptpcontainer *ptp) {
+	CHECK_SEQUENCE_NUMBER();
+	CHECK_SESSION();
+	cam->fuji_liveview = 0;
+	ptp_response(cam,PTP_RC_OK,0);
+	return 1;
+}
+
+#define FUJI_FRAME_BYTES 40000
+
+static int
+ptp_fuji_liveview_objectinfo(vcamera *cam, ptpcontainer *ptp) {
+	unsigned char	*data;
+	int		x = 0;
+
+	if (!fuji_frame_is_ready(cam)) {
+		ptp_response(cam,PTP_RC_InvalidObjectHandle,0);
+		return 1;
+	}
+	data = malloc(2000);
+	x += put_32bit_le (data+x, 0x00010001);	/* StorageID */
+	x += put_16bit_le (data+x, 0x3801);	/* ObjectFormat: JPEG */
+	x += put_16bit_le (data+x, 0);		/* ProtectionStatus */
+	x += put_32bit_le (data+x, FUJI_FRAME_BYTES); /* ObjectSize */
+	x += put_16bit_le (data+x, 0);		/* ThumbFormat */
+	x += put_32bit_le (data+x, 0);		/* ThumbSize */
+	x += put_32bit_le (data+x, 0);		/* ThumbPixWidth */
+	x += put_32bit_le (data+x, 0);		/* ThumbPixHeight */
+	x += put_32bit_le (data+x, 640);	/* ImagePixWidth */
+	x += put_32bit_le (data+x, 480);	/* ImagePixHeight */
+	x += put_32bit_le (data+x, 0);		/* ImageBitDepth */
+	x += put_32bit_le (data+x, 0);		/* ParentObject */
+	x += put_16bit_le (data+x, 0);		/* AssociationType */
+	x += put_32bit_le (data+x, 0);		/* AssociationDesc */
+	x += put_32bit_le (data+x, 0);		/* SequenceNumber */
+	x += put_string (data+x, "LIVEVIEW.JPG");
+	x += put_string (data+x, "20261026T120000");
+	x += put_string (data+x, "20261026T120000");
+	x += put_string (data+x, "");
+	ptp_senddata (cam, 0x1008, data, x);
+	free (data);
+	ptp_response(cam,PTP_RC_OK,0);
+	return 1;
+}
+
+static int
+ptp_fuji_liveview_getobject(vcamera *cam, ptpcontainer *ptp) {
+	unsigned char	*data;
+
+	if (!fuji_frame_is_ready(cam)) {
+		ptp_response(cam,PTP_RC_InvalidObjectHandle,0);
+		return 1;
+	}
+	data = calloc(1, FUJI_FRAME_BYTES);
+	data[0] = 0xff; data[1] = 0xd8;
+	data[FUJI_FRAME_BYTES-2] = 0xff; data[FUJI_FRAME_BYTES-1] = 0xd9;
+	ptp_senddata (cam, 0x1009, data, FUJI_FRAME_BYTES);
+	free (data);
+	ptp_response(cam,PTP_RC_OK,0);
+	return 1;
+}
+
+static int
+ptp_fuji_liveview_delete(vcamera *cam, ptpcontainer *ptp) {
+	if (!cam->fuji_liveview) {
+		ptp_response(cam,PTP_RC_InvalidObjectHandle,0);
+		return 1;
+	}
+	fuji_next_frame(cam);
+	ptp_response(cam,PTP_RC_OK,0);
+	return 1;
+}
+
+static int
+ptp_fuji_priority_getdesc (vcamera* cam, PTPDevicePropDesc *desc) {
+	desc->DevicePropCode		= 0xd207;
+	desc->DataType			= 4;	/* uint16 */
+	desc->GetSet			= 1;
+	desc->DefaultValue.u16		= 1;
+	desc->CurrentValue.u16		= cam->fuji_priority ? cam->fuji_priority : 1;
+	desc->FormFlag			= 0x02; /* enum */
+	desc->FORM.Enum.NumberOfValues	= 2;
+	desc->FORM.Enum.SupportedValue	= malloc(2*sizeof(desc->FORM.Enum.SupportedValue[0]));
+	desc->FORM.Enum.SupportedValue[0].u16 = 1;	/* Camera */
+	desc->FORM.Enum.SupportedValue[1].u16 = 2;	/* USB */
+	return 1;
+}
+
+static int
+ptp_fuji_priority_getvalue (vcamera* cam, PTPPropValue *val) {
+	val->u16 = cam->fuji_priority ? cam->fuji_priority : 1;
+	return 1;
+}
+
+static int
+ptp_fuji_priority_setvalue (vcamera* cam, PTPPropValue *val) {
+	cam->fuji_priority = val->u16;
+	return 1;
+}
+
+static int
+ptp_fuji_currentstate_getdesc (vcamera* cam, PTPDevicePropDesc *desc) {
+	desc->DevicePropCode		= 0xd212;
+	desc->DataType			= 4;	/* uint16 */
+	desc->GetSet			= 0;
+	desc->DefaultValue.u16		= 0;
+	desc->CurrentValue.u16		= 0;
+	desc->FormFlag			= 0;
+	return 1;
+}
+
+static int
+ptp_fuji_currentstate_getvalue (vcamera* cam, PTPPropValue *val) {
+	val->u16 = 0;
+	return 1;
+}
+
+/* PC mode (0xd38c), set by libgphoto2 when it prepares capturing */
+static uint16_t fuji_pcmode = 0;
+
+static int
+ptp_fuji_pcmode_getdesc (vcamera* cam, PTPDevicePropDesc *desc) {
+	desc->DevicePropCode		= 0xd38c;
+	desc->DataType			= 4;	/* uint16 */
+	desc->GetSet			= 1;
+	desc->DefaultValue.u16		= 0;
+	desc->CurrentValue.u16		= fuji_pcmode;
+	desc->FormFlag			= 0;
+	return 1;
+}
+
+static int
+ptp_fuji_pcmode_getvalue (vcamera* cam, PTPPropValue *val) {
+	val->u16 = fuji_pcmode;
+	return 1;
+}
+
+static int
+ptp_fuji_pcmode_setvalue (vcamera* cam, PTPPropValue *val) {
+	fuji_pcmode = val->u16;
+	return 1;
+}
