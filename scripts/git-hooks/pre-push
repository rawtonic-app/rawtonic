#!/bin/sh
# Pre-push guard for pushes to GitHub (the repository is public):
# - every author and committer address must be a noreply address, so no
#   personal e-mail address (and no commit from the history before the
#   public start) reaches the remote;
# - gitleaks, when installed, must find no secrets in the pushed commits.
# Install (shared by all worktrees): cp scripts/git-hooks/pre-push "$(git rev-parse --git-common-dir)/hooks/"
remote_url=$2
case "$remote_url" in
  *github.com*) ;;
  *) exit 0 ;;
esac
zero=0000000000000000000000000000000000000000
status=0
# shellcheck disable=SC2034  # remote_ref is part of git's input format
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue
  # A new branch, or a force push over a remote commit this clone does not
  # have (`git log REMOTE..LOCAL` would fail and check nothing).
  if [ "$remote_sha" = "$zero" ] || ! git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
    range="$local_sha --not --remotes=origin"
  else
    range="$remote_sha..$local_sha"
  fi
  # shellcheck disable=SC2086
  bad=$(git log --format='%h %ae %ce' $range | awk '
    $2 !~ /@users\.noreply\.github\.com$/ || $3 !~ /@users\.noreply\.github\.com$/')
  if [ -n "$bad" ]; then
    echo "pre-push: $local_ref has commits without a noreply address:" >&2
    echo "$bad" | head -5 >&2
    echo "Set: git config user.email <id>+<login>@users.noreply.github.com; a branch from" >&2
    echo "before the history rewrite must be rebased onto the rewritten origin branches." >&2
    status=1
    continue
  fi
  if command -v gitleaks >/dev/null 2>&1; then
    # shellcheck disable=SC2086
    if ! gitleaks git --no-banner --redact --log-opts="$range" . >/dev/null 2>&1; then
      echo "pre-push: gitleaks found possible secrets in $local_ref; run" >&2
      echo "  gitleaks git --log-opts=\"$range\" ." >&2
      status=1
    fi
  fi
done
exit $status
