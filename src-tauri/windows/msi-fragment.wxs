<?xml version="1.0" encoding="utf-8"?>
<!--
  Rawtonic MSI fragment (bundle.windows.wix.fragmentPaths): the MSI's
  counterpart of the NSIS hook in installer-hooks.nsh. The ComponentGroup
  links this fragment in (bundle.windows.wix.componentGroupRefs).

  The install runs no GPU warm-up: on a Radeon 680M the earlier one took
  over two minutes behind a busy cursor (notes: parity-gaps/G76). The app's
  first start compiles the pipelines and shows that it does.

  It also refuses to install while the per-user NSIS installation
  (Rawtonic_<version>_x64-setup.exe) is registered: Tauri's MSI takes the
  NSIS install folder from the registry and installs into it, so removing the
  NSIS copy afterwards would delete the MSI's files. The user uninstalls the
  NSIS copy first (libraries, edits and settings stay in the user profile).
  The NSIS uninstaller leaves that registry entry behind, so an install
  folder found in the user's LocalAppData is reset to Program Files: this
  per-machine install never goes into one user's profile.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Fragment>
    <ComponentGroup Id="RawtonicMsiFragment">
      <!-- The privacy notice on the Welcome dialog (msi-en-US.wxl) was shown:
           only an interactive install (full UI, UILevel 5: /qb and /qr show no Welcome dialog) sets the marker the app reads
           (src-tauri/src/privacy_notice.rs); a silent install does not, so the
           app then shows the notice itself on its first start. -->
      <Component Id="RawtonicPrivacyNoticeShown" Directory="INSTALLDIR" Guid="6f0d5b1e-3c1a-4e55-9a57-2f7c0c1d8e41">
        <Condition>UILevel &gt;= 5</Condition>
        <RegistryValue Root="HKCU" Key="Software\Rawtonic Project\Rawtonic" Name="PrivacyNoticeShown" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </ComponentGroup>
    <Property Id="RAWTONICNSISINSTALL" Secure="yes">
      <RegistrySearch Id="RawtonicNsisUninstall" Root="HKCU" Key="Software\Microsoft\Windows\CurrentVersion\Uninstall\Rawtonic" Name="UninstallString" Type="raw" />
    </Property>
    <Condition Message="Rawtonic is already installed for your user by its other installer (Rawtonic_..._x64-setup.exe). Uninstall that copy first in Settings, Apps (leave 'Delete the application data' unticked: your libraries, edits and settings stay), then run this installer again.">Installed OR NOT RAWTONICNSISINSTALL</Condition>
    <SetProperty Id="INSTALLDIR" Value="[ProgramFiles64Folder]Rawtonic\" After="AppSearch" Sequence="both">NOT Installed AND INSTALLDIR AND LocalAppDataFolder AND (INSTALLDIR ~&lt;&lt; LocalAppDataFolder)</SetProperty>
  </Fragment>
</Wix>
