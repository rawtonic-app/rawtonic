<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The bundle is signed with the hardened runtime. Library validation would
     refuse the bundled ONNX Runtime (Microsoft's build, signed separately) and
     with it every optional AI tool, so it is disabled for this app. -->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
</dict>
</plist>
