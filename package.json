{
  "name": "rawtonic",
  "author": "Rawtonic contributors; based on RapidRAW by Timon Käch",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "licenses": "node scripts/licenses.cjs",
    "tauri": "tauri",
    "start": "tauri dev",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "i18n:extract": "i18next-cli extract",
    "package:mac": "python3 scripts/package_macos.py",
    "package:mac:intel": "python3 scripts/package_macos.py --arch x86_64",
    "i18n:check": "i18next-cli extract --ci --dry-run && npm run i18n:runtime-check",
    "i18n:runtime-check": "node src/i18n/check-runtime.mjs",
    "i18n:lint": "i18next-cli lint",
    "test": "vitest run",
    "core:test": "cargo test -p rawtonic-catalog -p rawtonic-naming -p rawtonic-ingest -p rawtonic-fs -p rawtonic-metadata -p rawtonic-fileops"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-os": "^2.4.0",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-shell": "^2.6.0",
    "@uiw/color-convert": "^2.10.4",
    "@uiw/react-color-wheel": "^2.10.4",
    "clsx": "^2.1.1",
    "framer-motion": "^13.5.1",
    "i18next": "^26.7.2",
    "konva": "^10.9.1",
    "lodash.debounce": "^4.0.8",
    "lodash.throttle": "^4.1.1",
    "lucide-react": "^1.73.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.13",
    "react-image-crop": "^11.1.2",
    "react-konva": "^19.3.2",
    "react-toastify": "^11.2.0",
    "uuid": "^14.0.3",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "@tauri-apps/cli": "^2.12.5",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/lodash.debounce": "^4.0.9",
    "@types/lodash.throttle": "^4.1.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.3.0",
    "axe-core": "^4.14.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "eslint-plugin-i18next": "^6.1.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "i18next-cli": "^1.88.0",
    "jsdom": "^30.1.1",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "@swc/core@1.16.21": true,
    "esbuild@0.28.2": true
  },
  "version": "0.1.0-alpha.22",
  "license": "AGPL-3.0-or-later",
  "overrides": {
    "minimatch": "^11.0.4"
  }
}
