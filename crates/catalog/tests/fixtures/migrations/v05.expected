'index' | 'sqlite_autoindex_masks_1' | 'masks' | NULL
'index' | 'sqlite_autoindex_metadata_1' | 'metadata' | NULL
'index' | 'sqlite_autoindex_naming_templates_1' | 'naming_templates' | NULL
