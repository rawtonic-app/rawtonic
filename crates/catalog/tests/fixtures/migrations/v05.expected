'index' | 'stack_members_stack' | 'stack_members' | 'CREATE INDEX stack_members_stack ON stack_members(stack_id, position)'
'index' | 'tasks_kind_state' | 'tasks' | 'CREATE INDEX tasks_kind_state ON tasks(kind, state)'
'index' | 'versions_ai_facts' | 'versions' | 'CREATE INDEX versions_ai_facts ON versions(ai_facts, asset_id) WHERE ai_facts != 0'
'table' | 'asset_imports' | 'asset_imports' | 'CREATE TABLE "asset_imports"(
 asset_id TEXT PRIMARY KEY REFERENCES assets(id) ON DELETE CASCADE,
 batch_id INTEGER NOT NULL REFERENCES "import_batches"(id) ON DELETE CASCADE
)'
'table' | 'asset_keywords' | 'asset_keywords' | 'CREATE TABLE asset_keywords(
 asset_id TEXT NOT NULL REFERENCES assets(id) ON DELETE CASCADE,
 keyword TEXT NOT NULL COLLATE NOCASE,
 PRIMARY KEY(asset_id, keyword)
) WITHOUT ROWID'
'table' | 'asset_search' | 'asset_search' | 'CREATE VIRTUAL TABLE asset_search USING fts5(asset_id UNINDEXED, content, tokenize=''trigram case_sensitive 1'')'
'table' | 'asset_search_config' | 'asset_search_config' | 'CREATE TABLE ''asset_search_config''(k PRIMARY KEY, v) WITHOUT ROWID'
'table' | 'asset_search_content' | 'asset_search_content' | 'CREATE TABLE ''asset_search_content''(id INTEGER PRIMARY KEY, c0, c1)'
'table' | 'asset_search_data' | 'asset_search_data' | 'CREATE TABLE ''asset_search_data''(id INTEGER PRIMARY KEY, block BLOB)'
'table' | 'asset_search_docsize' | 'asset_search_docsize' | 'CREATE TABLE ''asset_search_docsize''(id INTEGER PRIMARY KEY, sz BLOB)'
'table' | 'asset_search_idx' | 'asset_search_idx' | 'CREATE TABLE ''asset_search_idx''(segid, term, pgno, PRIMARY KEY(segid, term)) WITHOUT ROWID'
'table' | 'assets' | 'assets' | 'CREATE TABLE assets(
 id TEXT PRIMARY KEY, root_id TEXT NOT NULL REFERENCES roots(id), rel_path TEXT NOT NULL,
 size INTEGER NOT NULL, mtime INTEGER NOT NULL, fingerprint TEXT NOT NULL, capture_time TEXT,
 camera TEXT NOT NULL DEFAULT '''', lens TEXT NOT NULL DEFAULT '''', width INTEGER, height INTEGER,
 orientation INTEGER NOT NULL DEFAULT 1, kind TEXT NOT NULL, raw_jpeg_pair TEXT, stack TEXT,
 missing INTEGER NOT NULL DEFAULT 0, search_text TEXT NOT NULL DEFAULT '''', sha256 TEXT, companion_size INTEGER, companion_fingerprint TEXT, companion_sha256 TEXT, make TEXT NOT NULL DEFAULT '''', focal_length REAL, aperture REAL, iso INTEGER, exposure REAL, facts_read INTEGER NOT NULL DEFAULT 0, trashed INTEGER NOT NULL DEFAULT 0 CHECK(trashed IN (0,1)), source_type TEXT NOT NULL DEFAULT '''', exposure_mode INTEGER, exposure_bias REAL, sequence INTEGER, UNIQUE(root_id, rel_path)
)'
'table' | 'capture_overrides' | 'capture_overrides' | 'CREATE TABLE capture_overrides(
 asset_id TEXT PRIMARY KEY REFERENCES assets(id) ON DELETE CASCADE,
 captured TEXT NOT NULL, subsec TEXT, offset TEXT)'
'table' | 'collection_assets' | 'collection_assets' | 'CREATE TABLE "collection_assets"(
 collection_id TEXT REFERENCES "collections"(id) ON DELETE CASCADE,
 asset_id TEXT REFERENCES assets(id) ON DELETE CASCADE,
 PRIMARY KEY(collection_id, asset_id)
)'
'table' | 'collections' | 'collections' | 'CREATE TABLE "collections"(
 id TEXT PRIMARY KEY,
 name TEXT NOT NULL,
 parent TEXT REFERENCES "collections"(id),
 kind TEXT NOT NULL DEFAULT ''album'' CHECK(kind IN (''album'',''group'',''smart'')),
 position INTEGER NOT NULL DEFAULT 0,
 rules TEXT,
 CHECK((kind = ''smart'') = (rules IS NOT NULL))
)'
'table' | 'content_embeddings' | 'content_embeddings' | 'CREATE TABLE content_embeddings(
 asset_id TEXT PRIMARY KEY REFERENCES assets(id) ON DELETE CASCADE,
 model TEXT NOT NULL,
 fingerprint TEXT NOT NULL,
 scale REAL,
 vector BLOB,
 error TEXT,
 CHECK((vector IS NULL) = (error IS NOT NULL)),
 CHECK(vector IS NULL OR (length(vector)=768 AND scale IS NOT NULL)))'
'table' | 'export_recipes' | 'export_recipes' | 'CREATE TABLE export_recipes(id TEXT PRIMARY KEY, name TEXT NOT NULL, recipe_json TEXT NOT NULL)'
'table' | 'eye_reads' | 'eye_reads' | 'CREATE TABLE eye_reads(
 asset_id TEXT PRIMARY KEY REFERENCES assets(id) ON DELETE CASCADE,
 version INTEGER NOT NULL,
 fingerprint TEXT NOT NULL,
 error TEXT)'
'table' | 'face_eyes' | 'face_eyes' | 'CREATE TABLE face_eyes(
 asset_id TEXT NOT NULL REFERENCES assets(id) ON DELETE CASCADE,
 face INTEGER NOT NULL,
 x REAL NOT NULL, y REAL NOT NULL, w REAL NOT NULL, h REAL NOT NULL,
 state TEXT NOT NULL CHECK(state IN (''open'',''closed'',''notVisible'',''uncertain'')),
 ear REAL,
 accessories REAL,
 override_state TEXT CHECK(override_state IN (''open'',''closed'',''notVisible'')),
 PRIMARY KEY(asset_id, face))'
'table' | 'file_ops_log' | 'file_ops_log' | 'CREATE TABLE file_ops_log(id TEXT PRIMARY KEY, kind TEXT NOT NULL, state TEXT NOT NULL, payload TEXT NOT NULL, created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP)'
'table' | 'folder_root_volumes' | 'folder_root_volumes' | 'CREATE TABLE folder_root_volumes(path TEXT PRIMARY KEY, volume TEXT NOT NULL)'
'table' | 'hot_folder' | 'hot_folder' | 'CREATE TABLE hot_folder(
 id INTEGER PRIMARY KEY CHECK(id=1),
 folder TEXT NOT NULL,
 template TEXT NOT NULL,
 include_subfolders INTEGER NOT NULL DEFAULT 0,
 settings_json TEXT NOT NULL DEFAULT ''{}'',
 last_capture TEXT REFERENCES assets(id) ON DELETE SET NULL,
 started_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP
)'
'table' | 'hot_folder_files' | 'hot_folder_files' | 'CREATE TABLE hot_folder_files(
 rel_path TEXT PRIMARY KEY,
 size INTEGER NOT NULL,
 mtime_ns INTEGER
)'
'table' | 'image_hashes' | 'image_hashes' | 'CREATE TABLE image_hashes(
 asset_id TEXT PRIMARY KEY REFERENCES assets(id) ON DELETE CASCADE,
 hash TEXT NOT NULL, size INTEGER NOT NULL, mtime INTEGER NOT NULL)'
'table' | 'import_batches' | 'import_batches' | 'CREATE TABLE "import_batches"(
 id INTEGER PRIMARY KEY,
 kind TEXT NOT NULL CHECK(kind IN (''ingest'',''add'',''sync'',''hotfolder'',''tether'')),
 created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP
)'
'table' | 'ingest_items' | 'ingest_items' | 'CREATE TABLE ingest_items(
 job_id TEXT NOT NULL REFERENCES tasks(id) ON DELETE CASCADE,
 position INTEGER NOT NULL,
 number INTEGER NOT NULL,
 source TEXT NOT NULL,
 source_size INTEGER,
 source_mtime_ns INTEGER,
 source_fingerprint TEXT,
 companion TEXT,
 companion_size INTEGER,
 companion_mtime_ns INTEGER,
 companion_fingerprint TEXT,
 state TEXT NOT NULL CHECK(state IN (''pending'',''copying'',''done'',''failed'')),
 destination TEXT,
 companion_destination TEXT,
 error TEXT,
 PRIMARY KEY(job_id, position)
)'
'table' | 'keymaps' | 'keymaps' | 'CREATE TABLE keymaps(id TEXT PRIMARY KEY, name TEXT NOT NULL, bindings_json TEXT NOT NULL)'
'table' | 'masks' | 'masks' | 'CREATE TABLE masks(id TEXT PRIMARY KEY, version_id TEXT NOT NULL REFERENCES versions(id), vector_json TEXT, raster_path TEXT, hash TEXT)'
'table' | 'metadata' | 'metadata' | 'CREATE TABLE metadata(asset_id TEXT PRIMARY KEY REFERENCES assets(id) ON DELETE CASCADE,
 rating INTEGER NOT NULL DEFAULT 0 CHECK(rating BETWEEN 0 AND 5), label TEXT NOT NULL DEFAULT '''',
 flag INTEGER NOT NULL DEFAULT 0 CHECK(flag BETWEEN -1 AND 1), data TEXT NOT NULL DEFAULT ''{}'',
 xmp_hash TEXT, xmp_status TEXT NOT NULL DEFAULT ''pending'', from_camera INTEGER NOT NULL DEFAULT 0, xmp_publishing TEXT)'
'table' | 'naming_templates' | 'naming_templates' | 'CREATE TABLE naming_templates(id TEXT PRIMARY KEY, name TEXT NOT NULL, template TEXT NOT NULL)'
'table' | 'presets' | 'presets' | 'CREATE TABLE presets(id TEXT PRIMARY KEY, name TEXT NOT NULL, recipe_json TEXT NOT NULL)'
'table' | 'recipe_blob_refs' | 'recipe_blob_refs' | 'CREATE TABLE recipe_blob_refs(
 recipe_id INTEGER NOT NULL REFERENCES recipes(id) ON DELETE CASCADE,
 hash TEXT NOT NULL REFERENCES recipe_blobs(hash),
 PRIMARY KEY(recipe_id, hash)
)'
'table' | 'recipe_blobs' | 'recipe_blobs' | 'CREATE TABLE recipe_blobs(hash TEXT PRIMARY KEY, data TEXT NOT NULL)'
'table' | 'recipes' | 'recipes' | 'CREATE TABLE recipes(id INTEGER PRIMARY KEY, version_id TEXT NOT NULL REFERENCES versions(id) ON DELETE CASCADE,
 parent INTEGER REFERENCES recipes(id), schema_version INTEGER NOT NULL DEFAULT 1, payload TEXT NOT NULL,
 snapshot TEXT, created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP)'
'table' | 'roots' | 'roots' | 'CREATE TABLE roots(id TEXT PRIMARY KEY, path TEXT NOT NULL, volume_id TEXT, external INTEGER NOT NULL DEFAULT 0, volume_name TEXT, volume_path TEXT, volume_kind TEXT CHECK(volume_kind IN (''startup'',''local'',''removable'',''network'')))'
'table' | 'snapshot_blob_refs' | 'snapshot_blob_refs' | 'CREATE TABLE snapshot_blob_refs(
 snapshot_key INTEGER NOT NULL REFERENCES snapshots(key) ON DELETE CASCADE,
 hash TEXT NOT NULL REFERENCES recipe_blobs(hash),
 PRIMARY KEY(snapshot_key, hash)
)'
'table' | 'snapshots' | 'snapshots' | 'CREATE TABLE snapshots(
 key INTEGER PRIMARY KEY,
 id TEXT NOT NULL,
 version_id TEXT NOT NULL REFERENCES versions(id) ON DELETE CASCADE,
 name TEXT NOT NULL,
 created_at TEXT NOT NULL,
 adjustments TEXT NOT NULL,
 UNIQUE(version_id, id)
)'
'table' | 'stack_members' | 'stack_members' | 'CREATE TABLE stack_members(
 stack_id TEXT NOT NULL REFERENCES stacks(id) ON DELETE CASCADE,
 asset_id TEXT NOT NULL REFERENCES assets(id) ON DELETE CASCADE,
 copy TEXT NOT NULL DEFAULT '''',
 position INTEGER NOT NULL,
 PRIMARY KEY(asset_id, copy))'
'table' | 'stacks' | 'stacks' | 'CREATE TABLE stacks(
 id TEXT PRIMARY KEY,
 collapsed INTEGER NOT NULL DEFAULT 1 CHECK(collapsed IN (0,1)))'
'table' | 'styles' | 'styles' | 'CREATE TABLE styles(id TEXT PRIMARY KEY, name TEXT NOT NULL, recipe_json TEXT NOT NULL)'
'table' | 'tasks' | 'tasks' | 'CREATE TABLE tasks(id TEXT PRIMARY KEY, kind TEXT NOT NULL, state TEXT NOT NULL, payload TEXT NOT NULL, progress REAL NOT NULL DEFAULT 0, error TEXT, created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP)'
'table' | 'versions' | 'versions' | 'CREATE TABLE versions(id TEXT PRIMARY KEY, asset_id TEXT NOT NULL REFERENCES assets(id) ON DELETE CASCADE,
 name TEXT NOT NULL, is_primary INTEGER NOT NULL DEFAULT 0, head INTEGER, legacy_state TEXT, ai_facts INTEGER NOT NULL DEFAULT 0)'
'table' | 'workspaces' | 'workspaces' | 'CREATE TABLE workspaces(id TEXT PRIMARY KEY, name TEXT NOT NULL, settings_json TEXT NOT NULL)'
'trigger' | 'assets_ad' | 'assets' | 'CREATE TRIGGER assets_ad AFTER DELETE ON assets BEGIN
 DELETE FROM asset_search WHERE asset_id = old.id;
END'
'trigger' | 'assets_ai' | 'assets' | 'CREATE TRIGGER assets_ai AFTER INSERT ON assets BEGIN
 INSERT INTO asset_search(asset_id, content)
  VALUES(new.id, rawtonic_fold(new.rel_path || '' '' || new.search_text || '' '' || new.make || '' '' || new.camera || '' '' || new.lens));
END'
'trigger' | 'assets_au' | 'assets' | 'CREATE TRIGGER assets_au AFTER UPDATE OF rel_path, search_text, make, camera, lens ON assets BEGIN
 DELETE FROM asset_search WHERE asset_id = old.id;
 INSERT INTO asset_search(asset_id, content)
  VALUES(new.id, rawtonic_fold(new.rel_path || '' '' || new.search_text || '' '' || new.make || '' '' || new.camera || '' '' || new.lens));
END'
'trigger' | 'assets_image_hash_stale' | 'assets' | 'CREATE TRIGGER assets_image_hash_stale AFTER UPDATE OF size,mtime,fingerprint ON assets
 WHEN new.size IS NOT old.size OR new.mtime IS NOT old.mtime OR new.fingerprint IS NOT old.fingerprint
 BEGIN DELETE FROM image_hashes WHERE asset_id=new.id; END'
'trigger' | 'metadata_keywords_ai' | 'metadata' | 'CREATE TRIGGER metadata_keywords_ai AFTER INSERT ON metadata BEGIN
 INSERT OR IGNORE INTO asset_keywords(asset_id, keyword)
  SELECT new.asset_id, rawtonic_trim(value) FROM json_each(new.data, ''$.keywords'')
  WHERE json_valid(new.data) AND type = ''text'' AND rawtonic_trim(value) != '''';
END'
'trigger' | 'metadata_keywords_au' | 'metadata' | 'CREATE TRIGGER metadata_keywords_au AFTER UPDATE OF data ON metadata BEGIN
 DELETE FROM asset_keywords WHERE asset_id = old.asset_id;
 INSERT OR IGNORE INTO asset_keywords(asset_id, keyword)
  SELECT new.asset_id, rawtonic_trim(value) FROM json_each(new.data, ''$.keywords'')
  WHERE json_valid(new.data) AND type = ''text'' AND rawtonic_trim(value) != '''';
END'
'trigger' | 'recipes_ai_facts_au' | 'recipes' | 'CREATE TRIGGER recipes_ai_facts_au AFTER UPDATE OF payload ON recipes BEGIN
 UPDATE versions SET ai_facts = rawtonic_ai_facts(new.payload) WHERE head = new.id;
END'
'trigger' | 'stack_members_copy_gone' | 'versions' | 'CREATE TRIGGER stack_members_copy_gone AFTER DELETE ON versions
WHEN OLD.is_primary=0
BEGIN
 DELETE FROM stack_members WHERE asset_id=OLD.asset_id AND copy=OLD.name;
END'
'trigger' | 'stack_members_dissolve' | 'stack_members' | 'CREATE TRIGGER stack_members_dissolve AFTER DELETE ON stack_members
BEGIN
 DELETE FROM stacks WHERE id=OLD.stack_id
  AND (SELECT count(*) FROM stack_members WHERE stack_id=OLD.stack_id) < 2;
END'
'trigger' | 'versions_ai_facts_ai' | 'versions' | 'CREATE TRIGGER versions_ai_facts_ai AFTER INSERT ON versions BEGIN
 UPDATE versions SET ai_facts = rawtonic_ai_facts(
  CASE WHEN new.head IS NOT NULL THEN (SELECT payload FROM recipes WHERE id=new.head) ELSE new.legacy_state END)
 WHERE id = new.id;
END'
'trigger' | 'versions_ai_facts_au' | 'versions' | 'CREATE TRIGGER versions_ai_facts_au AFTER UPDATE OF head, legacy_state ON versions BEGIN
 UPDATE versions SET ai_facts = rawtonic_ai_facts(
  CASE WHEN new.head IS NOT NULL THEN (SELECT payload FROM recipes WHERE id=new.head) ELSE new.legacy_state END)
 WHERE id = new.id;
END'
