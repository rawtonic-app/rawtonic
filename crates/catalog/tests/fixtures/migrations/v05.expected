# user_version 25
# schema
'index' | 'asset_imports_batch' | 'asset_imports' | 'CREATE INDEX asset_imports_batch ON asset_imports(batch_id)'
'index' | 'asset_keywords_keyword' | 'asset_keywords' | 'CREATE INDEX asset_keywords_keyword ON asset_keywords(keyword)'
'index' | 'assets_capture_time' | 'assets' | 'CREATE INDEX assets_capture_time ON assets(capture_time)'
'index' | 'assets_facts_unread' | 'assets' | 'CREATE INDEX assets_facts_unread ON assets(facts_read) WHERE facts_read=0'
'index' | 'assets_fingerprint' | 'assets' | 'CREATE INDEX assets_fingerprint ON assets(fingerprint)'
'index' | 'image_hashes_hash' | 'image_hashes' | 'CREATE INDEX image_hashes_hash ON image_hashes(hash)'
'index' | 'metadata_rating' | 'metadata' | 'CREATE INDEX metadata_rating ON metadata(rating)'
'index' | 'primary_version' | 'versions' | 'CREATE UNIQUE INDEX primary_version ON versions(asset_id) WHERE is_primary=1'
'index' | 'recipe_blob_refs_hash' | 'recipe_blob_refs' | 'CREATE INDEX recipe_blob_refs_hash ON recipe_blob_refs(hash)'
'index' | 'snapshot_blob_refs_hash' | 'snapshot_blob_refs' | 'CREATE INDEX snapshot_blob_refs_hash ON snapshot_blob_refs(hash)'
'index' | 'sqlite_autoindex_asset_imports_1' | 'asset_imports' | NULL
'index' | 'sqlite_autoindex_assets_1' | 'assets' | NULL
'index' | 'sqlite_autoindex_assets_2' | 'assets' | NULL
